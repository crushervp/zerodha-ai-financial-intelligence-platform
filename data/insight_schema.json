{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioInsightReport",
  "type": "object",
  "required": [
    "portfolio_id",
    "summary",
    "portfolio_health_score",
    "key_drivers",
    "recommendation_cards",
    "data_freshness",
    "regulatory_disclaimer"
  ],
  "properties": {
    "portfolio_id": { "type": "string" },
    "summary": { "type": "string" },
    "portfolio_health_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "data_freshness": { "type": "string", "enum": ["REAL_TIME", "DELAYED", "STALE"] },
    "key_drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "impact_pct", "direction", "rationale"],
        "properties": {
          "symbol": { "type": "string" },
          "impact_pct": { "type": "number" },
          "direction": { "type": "string", "enum": ["POSITIVE", "NEGATIVE"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "recommendation_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "card_id",
          "category",
          "title",
          "summary",
          "rationale",
          "supporting_metrics",
          "confidence",
          "disclaimer"
        ],
        "properties": {
          "card_id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["EDUCATIONAL_INSIGHT", "RISK_ALERT", "RECOMMENDATION_PROMPT"]
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "rationale": { "type": "string" },
          "supporting_metrics": { "type": "object" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "disclaimer": { "type": "string" }
        }
      }
    },
    "regulatory_disclaimer": { "type": "string" }
  }
}